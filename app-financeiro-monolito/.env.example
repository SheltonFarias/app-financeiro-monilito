# Porta do servidor backend
PORT=3001

# Usuário de acesso ao sistema
AUTH_USER=sheltonfarias

# Hash bcrypt da senha (custo 12). ATENÇÃO: escape os $ com \$ pois o Next.js expande variáveis no .env
# Para gerar: node -e "const b=require('bcryptjs');console.log(b.hashSync('SUA_SENHA',12).replaceAll('\$','\\$\$'))"
AUTH_PASSWORD_HASH=\$2b\$12\$0jHrI10Ls3JyrL5enfJYE.w7daxORd/rsO0a2dEUbYa4YescpGhtq

# Chave secreta para assinar os JWTs
JWT_SECRET=financeiro2026-jwt-secret-super-seguro-xK9mP2qR8vL5nT3w

# Tempo de expiração do JWT
JWT_EXPIRES_IN=8h

# URL do frontend (para configuração do CORS)
FRONTEND_URL=http://localhost:5173

# Telegram Bot: nunca versione os valores reais.
TELEGRAM_BOT_TOKEN=
# Gere um valor aleatório longo, por exemplo no PowerShell:
# [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
TELEGRAM_WEBHOOK_SECRET=
# Execute /start no bot, copie o ID exibido e informe-o abaixo.
TELEGRAM_ALLOWED_CHAT_ID=
