generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── NextAuth.js Models ────────────────────────────────────────────

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  senhaHash      String?
  createdAt      DateTime        @default(now())
  accounts       Account[]
  sessions       Session[]
  financiamentos Financiamento[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domínio do App ────────────────────────────────────────────────

model Financiamento {
  id                    String   @id @default(cuid())
  userId                String
  descricao             String
  banco                 String
  agencia               String?
  numeroContrato        String?
  programa              String?

  // Composição financeira
  valorImovel           Float
  valorFinanciado       Float
  recursosProprios      Float    @default(0)
  descontoFGTS          Float    @default(0)

  // Taxas e sistema
  taxaJurosNominalAnual Float
  taxaEfetivaAnual      Float?
  sistemaAmort          String   @default("PRICE")
  indiceCorrecao        String   @default("TR")

  // Prazo
  prazoMeses            Int
  dataInicio            DateTime
  parcelaAtual          Int      @default(1)

  // Encargos contratuais
  prestacaoInicialAJ    Float
  seguroMensal          Float    @default(0)
  totalMensalInicial    Float
  tarifaAdministracao   Float    @default(0)
  garantiaFiduciaria    Float?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User               @relation(fields: [userId], references: [id])
  parcelasPagas         ParcelaPaga[]
  amortizacoesExtras    AmortizacaoExtra[]
  indicesCache          IndiceBCBCache[]
}

model ParcelaPaga {
  id                String        @id @default(cuid())
  financiamentoId   String
  numeroParcela     Int
  dataVencimento    DateTime
  dataPagamentoReal DateTime?
  valorPago         Float
  seguroPago        Float?
  observacao        String?

  financiamento     Financiamento @relation(fields: [financiamentoId], references: [id], onDelete: Cascade)

  @@unique([financiamentoId, numeroParcela])
}

model AmortizacaoExtra {
  id                String        @id @default(cuid())
  financiamentoId   String
  dataPagamento     DateTime
  valor             Float
  modalidade        String        // REDUZ_PRAZO | REDUZ_PRESTACAO
  parcelaReferencia Int?
  economiaJuros     Float?
  mesesEconomizados Int?
  novoSaldoDevedor  Float?
  observacao        String?

  financiamento     Financiamento @relation(fields: [financiamentoId], references: [id], onDelete: Cascade)
}

model IndiceBCBCache {
  id              String        @id @default(cuid())
  financiamentoId String
  serie           Int           // 226 = TR, 433 = IPCA
  competencia     String        // "YYYY-MM"
  valor           Float
  criadoEm        DateTime      @default(now())

  financiamento   Financiamento @relation(fields: [financiamentoId], references: [id], onDelete: Cascade)

  @@unique([financiamentoId, serie, competencia])
}
