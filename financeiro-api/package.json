{
  "name": "financeiro-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "test:database": "node --test test/database/dashboard.integration.test.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "vercel-build": "npm run prisma:generate && npm run prisma:migrate",
    "postinstall": "npm run prisma:generate"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
