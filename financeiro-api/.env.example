# Porta da API independente
PORT=3001

# Mesmo banco PostgreSQL usado pela API independente.
DATABASE_URL=
# URL direta do PostgreSQL, usada apenas pelo Prisma ao aplicar migrações.
# No Supabase, não use a URL do Transaction Pooler (porta 6543) neste campo.
DIRECT_URL=
# Origens permitidas, separadas por vírgula. Em produção, use os domínios reais.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Temporariamente iguais aos segredos do monólito: permitem que o JWT tenha o
# mesmo contrato durante a migração. Em produção, injete estes valores pelo
# provedor de deploy, nunca por commit.
AUTH_USER=sheltonfarias
AUTH_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRES_IN=8h

TELEGRAM_BOT_TOKEN=

TELEGRAM_WEBHOOK_SECRET=

BRAPI_TOKEN=
